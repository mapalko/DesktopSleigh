<Project>
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <PublishDir>$(MSBuildProjectDirectory)\artifacts\portable-win-x64\</PublishDir>
  </PropertyGroup>
  <ItemGroup>
    <None Update="LICENSE" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="Assets\AUDIO-LICENSE.md" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <Target Name="IncludePortableRuntimeNotices" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_PortableCoreRuntime Include="@(ResolvedRuntimePack)" Condition="'%(FrameworkName)' == 'Microsoft.NETCore.App'" />
      <_PortableDesktopRuntime Include="@(ResolvedRuntimePack)" Condition="'%(FrameworkName)' == 'Microsoft.WindowsDesktop.App'" />
      <ResolvedFileToPublish Include="%(_PortableCoreRuntime.PackageDirectory)\LICENSE.TXT">
        <RelativePath>licenses\DOTNET-LICENSE.txt</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="%(_PortableCoreRuntime.PackageDirectory)\THIRD-PARTY-NOTICES.TXT">
        <RelativePath>licenses\DOTNET-THIRD-PARTY-NOTICES.txt</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="%(_PortableDesktopRuntime.PackageDirectory)\LICENSE">
        <RelativePath>licenses\WINDOWSDESKTOP-LICENSE.txt</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
